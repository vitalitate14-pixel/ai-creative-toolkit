{
    "name": "ai-creation-toolkit-desktop",
    "version": "6.0.0",
    "description": "AI Creation Toolkit Desktop Version",
    "main": "main.js",
    "author": "ITEN Creative Toolkit",
    "repository": {
        "type": "git",
        "url": "https://github.com/secure-artifacts/ai-tool.git"
    },
    "scripts": {
        "start": "electron .",
        "start:dev": "NODE_ENV=development electron .",
        "build:mac": "electron-builder --mac",
        "build:win": "electron-builder --win",
        "build:all": "electron-builder --mac --win"
    },
    "build": {
        "appId": "com.iten.ai-toolkit",
        "productName": "AI创作工具包",
        "artifactName": "ai-creative-toolkit-${version}-${arch}.${ext}",
        "directories": {
            "output": "../dist-electron"
        },
        "files": [
            "main.js",
            "preload.js",
            "security.cjs",
            "icon.png"
        ],
        "extraResources": [
            {
                "from": "../dist",
                "to": "app"
            },
            {
                "from": "../runtime",
                "to": "runtime"
            }
        ],
        "mac": {
            "category": "public.app-category.productivity",
            "icon": "icon.icns",
            "target": [
                "dmg",
                "zip"
            ]
        },
        "win": {
            "icon": "icon.ico",
            "target": [
                "nsis",
                "portable"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "devDependencies": {
        "electron": "^45.1.0",
        "electron-builder": "^26.18.0"
    },
    "overrides": {
        "tar": "^7.5.16"
    },
    "dependencies": {
        "puppeteer-core": "^25.16.0"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
